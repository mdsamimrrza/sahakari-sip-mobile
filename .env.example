# ============================================================
# SahakariSIP Mobile — Environment Template
# ============================================================
# Copy to `.env` and fill in your own values.
#
# ONLY `EXPO_PUBLIC_*` variables belong in .env. Everything with that
# prefix is inlined into the shipped JS bundle, so treat it as public.
#
# NEVER put the web app's server-side secrets here — SUPABASE_SERVICE_ROLE_KEY,
# SUPABASE_JWT_SECRET, AUTH_SECRET, the Google OAuth secret, the Gmail app
# password, VAPID_PRIVATE_KEY and CRON_SECRET must not ship inside an APK.
# ============================================================

# Supabase project URL (public).
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Supabase anon/public key. Safe to ship — constrained by Row Level Security.
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Default data mode: "cloud" (Supabase) or "local" (on-device storage).
# Users can switch at runtime from the auth screens and Settings.
EXPO_PUBLIC_DEFAULT_DATA_MODE=local

# ============================================================
# _verify/verify.test.ts (live-backend E2E script) ONLY — never inlined
# into the app bundle, never committed. Rotate immediately if leaked.
# ============================================================
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
